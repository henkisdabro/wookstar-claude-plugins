{
  "mcpServers": {
    "mikrotik": {
      "command": "uvx",
      "args": [
        "mcp-server-mikrotik"
      ],
      "env": {
        "MIKROTIK_HOST": "${user_config.mikrotik_host}",
        "MIKROTIK_USERNAME": "${user_config.mikrotik_username}",
        "MIKROTIK_PASSWORD": "${user_config.mikrotik_password}",
        "MIKROTIK_PORT": "${user_config.mikrotik_port}"
      }
    }
  }
}
